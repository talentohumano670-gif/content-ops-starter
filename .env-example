NEXT_PUBLIC_ALGOLIA_APP_ID=
NEXT_PUBLIC_ALGOLIA_INDEX_NAME=
NEXT_PUBLIC_ALGOLIA_SEARCH_API_KEY=

# Both optional: with no env vars set at all, the first visit to /horarios/admin lets you
# set the administrador key from the browser (stored hashed) — no Netlify config needed.
# Set SCHEDULE_ADMIN_KEY here only if you want the key pinned by deploy config instead.
SCHEDULE_ADMIN_KEY=
# Secret used to sign login sessions (falls back to SCHEDULE_ADMIN_KEY, then to an
# auto-generated persisted secret, if unset)
SCHEDULE_SESSION_SECRET=